param int MLKEM_PKE_PUBLICKEYBYTES = 384*3+32;
param int MLKEM_PKE_SECRETKEYBYTES = 384*3;

param int X25519_PUBLICKEYBYTES = 32;
param int X25519_SECRETKEYBYTES = 32;

param int s_BYTES = 16;
param int d_BYTES = 32;

param int CUKEM_PUBLICKEYBYTES = MLKEM_PKE_PUBLICKEYBYTES + X25519_PUBLICKEYBYTES;
param int CUKEM_SECRETKEYBYTES = MLKEM_PKE_SECRETKEYBYTES + X25519_SECRETKEYBYTES + s_BYTES + MLKEM_PKE_PUBLICKEYBYTES;
